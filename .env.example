# All values below should come from NEW resources created specifically for
# this project — see SETUP_CHECKLIST.md. Do not reuse production credentials.

# ── Meta / Instagram ──────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://your-vercel-app.vercel.app/api/share/connect/callback/instagram

# ── Google / YouTube ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-vercel-app.vercel.app/api/share/connect/callback/youtube

# ── Cloudflare R2 (S3-compatible) ────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=arre-audiograms
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ── Supabase ──────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── App ───────────────────────────────────────────────────────────
# Used to build deep links back into the Arre Voice app in captions/descriptions
APP_DEEP_LINK_BASE=https://arrevoice.app.link
